{
  "name": "orch-companion",
  "productName": "Orch Companion",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop pet that shows what orch is doing.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build && esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --out-extension:.js=.cjs --outdir=dist-electron",
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "package": "npm run build && electron-packager . \"Orch Companion\" --platform=darwin --arch=arm64 --out=out --overwrite --app-bundle-id=dev.orch.companion --extend-info=extend-info.plist --icon=build/icon.icns --ignore=\"^/(src|electron|scripts|test|shots|out|build|\\.impeccable|index\\.html|tsconfig\\.json|vite\\.config\\.ts|extend-info\\.plist|\\.gitignore)\" --prune=true",
    "shoot": "node --experimental-strip-types --no-warnings scripts/shoot.ts",
    "icon": "esbuild scripts/icon.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=build/icon.mjs && node build/icon.mjs && rm build/icon.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
